name = "m2-publisher"
main = "src/index.js"
compatibility_date = "2026-10-15"
workers_dev = true

[triggers]
crons = ["*/15 * * * *"]

[[d1_databases]]
binding = "DB"
database_name = "m2-publisher-db"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"

[vars]
IG_EXPECTED_USERNAME = "maqued2"
META_GRAPH_VERSION = "v25.0"
# Publishing stays DISABLED until the user authorizes their Instagram account.
PUBLISHING_ENABLED = "false"
